<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!--
        Android 11（API 30）起，应用默认"看不见"别的应用。不在这里声明要在找什么，
        `intent.resolveActivity(packageManager)` 对系统相机也会返回 null —— 结果就是
        明明有相机，程序却报"没有找到可用的相机应用"，拍照识别这条路直接死掉。
        这是一条真实的功能性声明，不是权限申请。
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- 发送 VBAN 报文 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 回放捕获（抓手机正在播放的声音）要求持有录音权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 捕获要在前台服务里跑，否则切到后台就被系统掐掉 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14（API 34）起，前台服务必须声明具体类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 13 起，前台服务通知要用户授权才会显示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 熄屏时不要让 CPU 睡下去，否则捕获会断流 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 实时扫码要开相机。运行时申请，只在进扫码页时问一次。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required=false：没有相机的设备也能装，只是不能用扫码（还能手填地址/短码）。
         第二行不是重复：声明 CAMERA 权限会让系统隐式要求 android.hardware.camera，
         不显式覆盖的话，无相机设备会被判定为不兼容。 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 应用内更新：从 GitHub 下载新 APK 后唤起系统安装器（Android 8 起装未知来源要先授权） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- allowBackup=false 与 dataExtractionRules 并存不是重复：
         前者管 Android 11 及以下（adb backup / 老式云备份），后者管 12+ 的新规则。
         只留后者的话，11 上仍会把配对密钥备份出去。 -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light"
        tools:ignore="DataExtractionRules">

        <!-- 主界面不要系统 ActionBar：它会顶着一条写着 "AudioHub Sender" 的灰条，
             和我们自己画的卡片式界面完全两套语言。标题改由界面自己画（带图标 + 副标题）。 -->
        <!-- 竖屏锁死不跟随旋屏：这是"发送端遥控面板"，横过来只会把卡片拉成长条。
             Lint 的 DiscouragedApi/LockedOrientationActivity 是针对平板/折叠屏的通用提醒，
             本项目手机定屏是有意的取舍，这里显式抑制并留下理由。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 实时扫码页。竖屏锁死：旋屏会重建 Activity，相机会重绑一次，没必要。 -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:label="@string/scan_live_title"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- 捕获服务。exported=false：只有本应用能启动它。 -->
        <service
            android:name=".AudioCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 供"应用内更新"把下载好的 APK 交给系统安装器读（自写 Provider，见 ApkProvider.kt） -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.audiohub.sender.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 拍二维码时的临时照片落点：系统相机要能写入这个 content:// 地址。
             只服务缓存目录下的 scan/，用完即删（见 CaptureProvider.kt）。
             注意：这里没有 CAMERA 权限，也不需要——拍照由系统相机应用完成。 -->
        <provider
            android:name=".CaptureProvider"
            android:authorities="com.audiohub.sender.photo"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
