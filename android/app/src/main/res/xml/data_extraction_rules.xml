<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ 的备份/迁移规则。
    配对密钥（PSK）存在 EncryptedSharedPreferences 里，绝不能随云备份
    或换机迁移离开本机 —— 一旦被带走，就没法"删手机即失效"。
    所以这里把 sharedpref 整体排除，只保留普通设置项（音量、上次地址）。
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- 排除加密偏好文件所在目录：密钥不备份到云端 -->
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- 换机迁移同样排除：新机必须重新配对 -->
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
