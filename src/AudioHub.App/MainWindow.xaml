<Window x:Class="AudioHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioHub"
        Icon="/Assets/AudioHub.ico"
        Height="460" Width="540"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <TextBlock x:Name="StatusText" FontSize="13" Margin="0,0,0,6" />
<TextBlock x:Name="NetworkText" FontSize="12" Margin="0,0,0,6"
           TextWrapping="Wrap" Foreground="Gray" />
<TextBlock x:Name="CeilingText" FontSize="12" Margin="0,0,0,14"
           TextWrapping="Wrap" Foreground="Gray" />

            <TextBlock Text="输出设备" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBlock x:Name="DeviceNameText" FontSize="12" Foreground="Gray"
                       TextWrapping="Wrap" Margin="0,0,0,16" />

            <TextBlock Text="音源" FontWeight="SemiBold" Margin="0,0,0,5" />
            <StackPanel x:Name="ChannelPanel" />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="启动" Padding="14,5" Margin="0,0,8,0" Click="Start_Click" />
                <Button Content="停止" Padding="14,5" Click="Stop_Click" />
            </StackPanel>

            <TextBlock x:Name="UrlText" Margin="0,16,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
