<Window x:Class="AudioHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioHub"
        Icon="/Assets/AudioHub.ico"
        Height="460" Width="540"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <TextBlock x:Name="StatusText" FontSize="13" Margin="0,0,0,6" />
<TextBlock x:Name="NetworkText" FontSize="12" Margin="0,0,0,6"
           TextWrapping="Wrap" Foreground="Gray" />
<TextBlock x:Name="CeilingText" FontSize="12" Margin="0,0,0,14"
           TextWrapping="Wrap" Foreground="Gray" />

            <Expander x:Name="ManualExpander" IsExpanded="False" Margin="0,0,0,14"
                      Expanded="ManualExpander_Expanded" Collapsed="ManualExpander_Collapsed">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="手动连接" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="ShortCodeHeader" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontFamily="Consolas" FontSize="15" Foreground="#2563EB" />
                    </StackPanel>
                </Expander.Header>

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="手机连不上时用这里。手机与电脑必须能在同一网络内互发 UDP；如果是 AP 隔离（校园网、公共 WiFi 常见），任何方式都不通，请改用手机热点或 USB 网络共享。"
                               FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="本机地址" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                        <TextBlock x:Name="AddressText" Grid.Column="1" FontSize="12" FontFamily="Consolas"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Content="复制" Grid.Column="2" Padding="8,2" Click="CopyAddress_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="端口" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                        <TextBlock x:Name="PortsText" Grid.Column="1" FontSize="12" FontFamily="Consolas"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="配对密钥" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                        <TextBlock x:Name="KeyText" Grid.Column="1" FontSize="12" FontFamily="Consolas"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="RevealKeyButton" Content="显示" Padding="8,2" Click="RevealKey_Click" />
                            <Button x:Name="CopyKeyButton" Content="复制" Padding="8,2" Margin="6,0,0,0"
                                    Click="CopyKey_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="身份指纹" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                        <TextBlock x:Name="FingerprintText" Grid.Column="1" FontSize="12" FontFamily="Consolas"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="短码" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="ShortCodeText" FontSize="19" FontFamily="Consolas" FontWeight="SemiBold"
                                       Foreground="#2563EB" VerticalAlignment="Center" />
                            <TextBlock x:Name="ShortCodeNote" FontSize="11" Foreground="Gray" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="ShowQrButton" Content="显示二维码" Padding="10,4" Click="ToggleQr_Click" />
                        <Button Content="复制全部信息" Padding="10,4" Margin="8,0,0,0" Click="CopyAll_Click" />
                        <CheckBox x:Name="QrIncludeKeyCheck" Content="二维码包含配对密钥" Margin="12,0,0,0"
                                  VerticalAlignment="Center" Checked="QrIncludeKey_Changed"
                                  Unchecked="QrIncludeKey_Changed" />
                    </WrapPanel>

                    <Image x:Name="QrImage" Width="180" Height="180" Margin="0,10,0,0"
                           HorizontalAlignment="Left" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />

                    <TextBlock x:Name="QrNote" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="CopyHint" FontSize="11" Foreground="#1D9E75" Margin="0,6,0,0" />
                </StackPanel>
            </Expander>

            <TextBlock Text="输出设备" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBlock x:Name="DeviceNameText" FontSize="12" Foreground="Gray"
                       TextWrapping="Wrap" Margin="0,0,0,16" />

            <TextBlock Text="音源" FontWeight="SemiBold" Margin="0,0,0,5" />
            <StackPanel x:Name="ChannelPanel" />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="启动" Padding="14,5" Margin="0,0,8,0" Click="Start_Click" />
                <Button Content="停止" Padding="14,5" Click="Stop_Click" />
            </StackPanel>

            <TextBlock x:Name="UrlText" Margin="0,16,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
